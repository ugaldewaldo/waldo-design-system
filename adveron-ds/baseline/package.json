{
  "name": "@adveron/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "start": "next start -p 3006",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "codegen": "pnpm dlx openapi-typescript@7.4.4 ./openapi/adveron-api.json -o ./src/lib/api/schema.ts",
    "openapi:pull": "pnpm --filter @adveron/api openapi:emit ../adveron-web/openapi/adveron-api.json",
    "codegen:refresh": "pnpm openapi:pull && pnpm codegen",
    "codegen:check": "pnpm codegen:refresh && git diff --exit-code HEAD -- openapi/adveron-api.json src/lib/api/schema.ts",
    "assets:brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@scalar/api-reference-react": "0.9.24",
    "@tanstack/react-query": "^5.61.5",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-list": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/markdown": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "better-auth": "^1.6.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.525.0",
    "next": "15.5.21",
    "openapi-fetch": "^0.13.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^3.10.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "^15.5.21",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.10",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
